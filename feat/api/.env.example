# API listener
ACM_API_HOST=127.0.0.1
ACM_API_PORT=8088

# Keep the persistent database outside /home/WYJ/acm-forever-feat on production.
ACM_DATABASE_PATH=./data/acm_forever.db

# Replace both values with long random secrets before starting.
ACM_WEBUI_SECRET_KEY=replace-with-a-long-random-session-secret
ACM_BOT_API_TOKEN=replace-with-a-separate-long-random-service-token
ACM_WEBUI_COOKIE_SECURE=false

# Optional one-time creation of the first root account in an empty database.
# Remove both after the first successful initialization.
ACM_BOOTSTRAP_ROOT_QQ_ID=
ACM_BOOTSTRAP_ROOT_PASSWORD=

# Optional QQ IDs, separated by commas.
ACM_ROOT_QQ_IDS=
ACM_ADMIN_QQ_IDS=

# Optional compatibility login; prefer database-backed accounts.
ACM_WEBUI_ADMIN_USERNAME=
ACM_WEBUI_ADMIN_PASSWORD_HASH=
ACM_WEBUI_ADMIN_PASSWORD=
ACM_WEBUI_LEGACY_ADMIN_LOGIN=false
ACM_TEMP_PASSWORD_TTL_HOURS=72

# Set the exact production frontend origins and trusted reverse proxy IPs.
ACM_WEB_ALLOWED_ORIGINS=http://localhost:3000
ACM_WEBUI_TRUSTED_PROXIES=

# Optional OJ credentials used by server-side synchronization.
ACM_LUOGU_COOKIE=
ACM_LUOGU_CSRF_TOKEN=
ACM_CF_API_KEY=
ACM_CF_API_SECRET=
ACM_CJLU_USERNAME=
ACM_CJLU_PASSWORD=
