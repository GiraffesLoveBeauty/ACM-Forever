[Unit]
Description=ACM-Forever WebUI and API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/acm-forever-feat
EnvironmentFile=/root/acm-forever-data/.env
ExecStart=/root/acm-forever-data/venv/bin/python -m api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
