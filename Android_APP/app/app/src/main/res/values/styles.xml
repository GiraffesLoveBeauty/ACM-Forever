<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#315B36</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:buttonStyle">@style/AppFlatButton</item>
        <item name="android:imageButtonStyle">@style/AppFlatImageButton</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowAnimationStyle">@style/AppPageAnimations</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppFlatButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_button_flat</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="AppFlatImageButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#315B36</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:backgroundDimAmount">0.30</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:buttonStyle">@style/AppFlatButton</item>
        <item name="android:imageButtonStyle">@style/AppFlatImageButton</item>
    </style>
    <style name="AppDetailTheme" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">#F4F5F7</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/AppDetailAnimations</item>
    </style>
    <style name="AppPageAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_enter_right</item>
        <item name="android:activityOpenExitAnimation">@anim/page_stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_stay</item>
        <item name="android:activityCloseExitAnimation">@anim/page_exit_right</item>
    </style>
    <style name="AppDetailAnimations" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/page_enter_right</item>
        <item name="android:windowExitAnimation">@anim/page_exit_right</item>
    </style>
</resources>
